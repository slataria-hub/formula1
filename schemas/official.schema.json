{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "datasetStatus": {
      "enum": [
        "draft",
        "fixture",
        "verified"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/driver"
      }
    },
    "constructors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constructor"
      }
    },
    "circuits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/circuit"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "standings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/standing"
      }
    },
    "adjustments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adjustment"
      }
    },
    "fastestLaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fastestLap"
      }
    },
    "stints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stint"
      }
    },
    "entrants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrant"
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetStatus",
    "sources",
    "drivers",
    "constructors",
    "circuits",
    "events",
    "standings",
    "adjustments",
    "fastestLaps",
    "stints"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:f1-analytics:official:2.0.0",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "provider",
        "url",
        "retrievedAt",
        "sha256",
        "revision"
      ],
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "externalId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "externalId"
      ],
      "additionalProperties": false
    },
    "driver": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "givenName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "familyName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "birthDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "nationality": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "aliases",
        "sourceIds",
        "givenName",
        "familyName",
        "birthDate",
        "nationality"
      ],
      "additionalProperties": false
    },
    "constructor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "nationality": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "lineageId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "aliases",
        "sourceIds",
        "nationality",
        "lineageId"
      ],
      "additionalProperties": false
    },
    "circuit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "country": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locality": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "aliases",
        "sourceIds",
        "country",
        "locality"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "driverId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "constructorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "position": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "positionText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "started": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "classified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "finished",
            "retired",
            "dns",
            "dsq",
            "not_classified",
            "withdrawn",
            "excluded",
            "unknown"
          ]
        },
        "rawStatus": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "laps": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gridPosition": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "timeMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gapMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "qualifyingTimesMs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "entrantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "driverId",
        "constructorId",
        "position",
        "positionText",
        "points",
        "started",
        "classified",
        "status",
        "rawStatus",
        "laps",
        "gridPosition",
        "timeMs",
        "gapMs",
        "qualifyingTimesMs"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "practice_1",
            "practice_2",
            "practice_3",
            "qualifying",
            "sprint_qualifying",
            "sprint",
            "race",
            "grid"
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "pending_results",
            "partial",
            "provisional",
            "final",
            "cancelled",
            "unavailable"
          ]
        },
        "scheduledAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "scheduledAt",
        "sourceIds",
        "results"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^\\d{4}-R\\d{2,3}$"
        },
        "season": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 9999
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "circuitId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "in_progress",
            "completed",
            "cancelled",
            "unknown"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/session"
          }
        },
        "externalEventId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "grandPrixKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "id",
        "season",
        "round",
        "name",
        "circuitId",
        "date",
        "status",
        "sourceIds",
        "sessions"
      ],
      "additionalProperties": false
    },
    "standingRow": {
      "type": "object",
      "properties": {
        "entityId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "position": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "points": {
          "type": "number"
        },
        "wins": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "positionText": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "entrantId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        }
      },
      "required": [
        "entityId",
        "position",
        "points",
        "wins"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "position": {
                "type": "null"
              }
            }
          },
          "then": {
            "required": [
              "positionText"
            ],
            "properties": {
              "positionText": {
                "enum": [
                  "-",
                  "E",
                  "D"
                ]
              }
            }
          }
        }
      ]
    },
    "standing": {
      "type": "object",
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 9999
        },
        "afterRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "kind": {
          "enum": [
            "drivers",
            "constructors"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/standingRow"
          },
          "minItems": 1
        }
      },
      "required": [
        "season",
        "afterRound",
        "kind",
        "sourceIds",
        "rows"
      ],
      "additionalProperties": false
    },
    "adjustment": {
      "type": "object",
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 9999
        },
        "afterRound": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 999
            },
            {
              "type": "null"
            }
          ]
        },
        "entityId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "kind": {
          "enum": [
            "driver",
            "constructor"
          ]
        },
        "pointsDelta": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "season",
        "afterRound",
        "entityId",
        "kind",
        "pointsDelta",
        "reason",
        "sourceIds"
      ],
      "additionalProperties": false
    },
    "fastestLap": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "driverId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "lap": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "timeMs": {
          "type": "integer",
          "minimum": 1
        },
        "compound": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "sessionId",
        "driverId",
        "lap",
        "timeMs",
        "compound",
        "sourceIds"
      ],
      "additionalProperties": false
    },
    "stint": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "driverId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "lapFrom": {
          "type": "integer",
          "minimum": 1
        },
        "lapTo": {
          "type": "integer",
          "minimum": 1
        },
        "compound": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "tyreAgeAtStart": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "sessionId",
        "driverId",
        "number",
        "lapFrom",
        "lapTo",
        "compound",
        "tyreAgeAtStart",
        "sourceIds"
      ],
      "additionalProperties": false
    },
    "entrant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "constructorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "season": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 9999
        },
        "fromRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "toRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "constructorId",
        "season",
        "fromRound",
        "toRound",
        "sourceIds"
      ],
      "additionalProperties": false
    }
  }
}
