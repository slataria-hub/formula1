{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "predictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/override"
      }
    },
    "preferences": {
      "type": "object",
      "properties": {
        "selectedSeason": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 9999
        },
        "theme": {
          "enum": [
            "auto",
            "light",
            "dark"
          ]
        }
      },
      "required": [
        "selectedSeason",
        "theme"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "predictions",
    "overrides",
    "preferences"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:f1-analytics:user:2.0.0",
  "$defs": {
    "prediction": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "driverIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionId",
        "driverIds",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "driverId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+$"
        },
        "points": {
          "type": "number"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionId",
        "driverId",
        "points",
        "reason",
        "updatedAt"
      ],
      "additionalProperties": false
    }
  }
}
